---
// Stessa testata delle altre landing di @savez: marchio a sinistra, poi le
// sezioni della pagina (solo da tablet in su), GitHub e una sola azione piena.
import { meta } from '../data/meta.js'

const sections = [
  { href: '#privacy', label: 'Privacy' },
  { href: '#novita', label: 'Novità' },
  { href: '#installa', label: 'Installa' },
]
---

<nav class="nav" aria-label="Principale">
  <div class="container nav-inner">
    <a href="#top" class="nav-brand">
      <span class="nav-dot" aria-hidden="true"></span>
      <span>{meta.appName}</span>
    </a>
    <div class="nav-links">
      {sections.map((s) => <a class="nav-section" href={s.href}>{s.label}</a>)}
      <a class="nav-link" href={meta.githubUrl} rel="noopener noreferrer" target="_blank" aria-label="Codice su GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span class="nav-section">GitHub</span>
      </a>
      <a class="nav-cta" href={meta.demoUrl} rel="noopener noreferrer" target="_blank">Prova la demo</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    background: rgba(11, 13, 16, 0.7);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-weight: 600;
  }

  .nav-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 40px;
    padding: 0 0.6rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .nav-links a:hover {
    color: var(--text);
    opacity: 1;
  }

  .nav-links .nav-section {
    display: none;
  }

  .nav-links .nav-cta {
    margin-left: 0.5rem;
    padding: 0 1rem;
    border-radius: var(--radius-btn);
    background: var(--accent);
    color: #0b0d10;
    font-weight: 600;
  }

  .nav-links .nav-cta:hover {
    color: #0b0d10;
  }

  @media (min-width: 720px) {
    .nav-links .nav-section {
      display: inline-flex;
    }
  }
</style>
