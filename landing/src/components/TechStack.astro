---
import { meta } from '../data/meta.js'

const badges = [
  {
    alt: 'Vue 3',
    src: 'https://img.shields.io/badge/Vue-3-42b883?style=flat&logo=vue.js&logoColor=white',
  },
  {
    alt: 'Vuetify',
    src: 'https://img.shields.io/badge/Vuetify-3-1867C0?style=flat&logo=vuetify&logoColor=white',
  },
  {
    alt: 'Vite',
    src: 'https://img.shields.io/badge/Vite-5-646CFF?style=flat&logo=vite&logoColor=white',
  },
  {
    alt: 'IndexedDB via Dexie',
    src: 'https://img.shields.io/badge/IndexedDB-Dexie-FFB300?style=flat',
  },
  {
    alt: 'PWA / Workbox',
    src: 'https://img.shields.io/badge/PWA-installable-5A0FC8?style=flat',
  },
]
---

<section class="tech section" id="open-source">
  <div class="container">
    <h2 class="tech-title">Sotto il cofano.</h2>
    <p class="tech-sub">
      Vue 3, IndexedDB via Dexie, zero framework esotici. Apri il codice sorgente
      e lo capisci in un pomeriggio.
    </p>
    <p class="tech-author">
      <img src={`${import.meta.env.BASE_URL}progetti/savez.jpg`} alt="" width="40" height="40" loading="lazy" />
      <span>
        Scritto e mantenuto da
        <a href={meta.authorUrl} rel="noopener noreferrer" target="_blank">{meta.authorHandle}</a>,
        autore e contributor principale. Licenza MIT: le PR sono benvenute,
        <a href={meta.contributingUrl} rel="noopener noreferrer" target="_blank">ecco come contribuire</a>.
      </span>
    </p>
    <div class="tech-badges">
      {badges.map((b) => (
        <img src={b.src} alt={b.alt} loading="lazy" />
      ))}
    </div>
  </div>
</section>

<style>
  .tech-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .tech-sub {
    color: var(--text-muted);
    margin-top: 0.75rem;
    max-width: 56ch;
  }

  .tech-author {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.5rem;
    max-width: 60ch;
    color: var(--text-muted);
  }

  .tech-author img {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px var(--accent);
  }

  .tech-badges {
    margin-top: 2rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tech-badges img {
    height: 28px;
  }
</style>
